# VIMS Inspection - PSC Backend Environment Variables
# Copy this file to .env and fill in the values

# Django
DEBUG=True
SECRET_KEY=your-secret-key-here-change-in-production
ALLOWED_HOSTS=localhost,127.0.0.1
DB_ENGINE=mssql

# Database (SQL Server)
DB_HOST=localhost
DB_NAME=ksm_marine_live
DB_PORT=1433
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_ENCRYPT=no
DB_TRUST_SERVER_CERTIFICATE=yes
# Leave DB_USER/DB_PASSWORD empty to use Windows integrated auth.
DB_TRUSTED_CONNECTION=yes
DB_USER=
DB_PASSWORD=

# JWT Authentication (units: MINUTES)
JWT_ACCESS_TOKEN_LIFETIME=60
JWT_REFRESH_TOKEN_LIFETIME=43200

# File Upload
UPLOAD_BASE_PATH=uploads
MAX_FILE_SIZE_MB=3

# CORS (comma-separated list of allowed origins)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Email / Fleet Alert SMTP
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=pms@cymsol.co.in
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL="KSM Marine <pms@cymsol.co.in>"

# Slack / Certs alerts
# Use the bot token for the invited Slack app. Keep the token secret in .env only.
SLACK_BOT_TOKEN=replace-with-slack-bot-token
CERTS_SLACK_OFFICE_CHANNEL=C0BMCASMNKS
# Optional role-specific overrides. Leave blank to use the vims-certs channel above.
CERTS_SLACK_DPA_CHANNEL=
CERTS_SLACK_TECHNICAL_CHANNEL=
CERTS_SLACK_MARINE_CHANNEL=

# Slack / Safety alerts
# If Safety should use the same Slack incoming webhook path, set one of these.
SLACK_SAFETY_CHANNEL_WEBHOOK=
SLACK_WEBHOOK_URL=
