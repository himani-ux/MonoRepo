# Docker Compose Environment Variables
# Copy to .env and update values for your environment

# Django
SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=True

# Database (SQL Server)
# For Windows host with Docker, use host.docker.internal
DB_HOST=host.docker.internal
DB_NAME=ksm_cms_dev
DB_USER=
DB_PASSWORD=
DB_PORT=1433
# Set to 'yes' for Windows Authentication (SQL Server on Windows host)
DB_TRUSTED_CONNECTION=yes

# Frontend API URL
VITE_API_BASE_URL=http://localhost:8001/api/psc
